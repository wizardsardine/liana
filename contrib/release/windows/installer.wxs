<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer definition, compiled by wixl (GNOME msitools) from nix/windows-msi.nix.
  Every value that must be stable between builds comes in through a `-D` define:
    ProductName, Version, UpgradeCode, ProductCode, PackageCode,
    ExeComponentGuid, DocsComponentGuid, ExeName, StageDir
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Wizardsardine"
           UpgradeCode="$(var.UpgradeCode)">

    <Package Id="$(var.PackageCode)"
             InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Manufacturer="Wizardsardine"
             Description="$(var.ProductName) $(var.Version) installer"
             Comments="https://wizardsardine.com/liana/" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />

    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="$(var.StageDir)/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://wizardsardine.com/liana/" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="$(var.ProductName)">
          <Component Id="MainExecutable" Guid="$(var.ExeComponentGuid)" Win64="yes">
            <File Id="MainExe" Name="$(var.ExeName)" Source="$(var.StageDir)/$(var.ExeName)" KeyPath="yes">
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="$(var.ProductName)"
                        WorkingDirectory="INSTALLDIR"
                        Icon="app.ico"
                        IconIndex="0"
                        Advertise="yes" />
            </File>
          </Component>
          <Component Id="Documentation" Guid="$(var.DocsComponentGuid)" Win64="yes">
            <File Id="Licence" Name="LICENCE" Source="$(var.StageDir)/LICENCE" KeyPath="yes" />
            <File Id="Readme" Name="README.md" Source="$(var.StageDir)/README.md" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <Feature Id="Complete" Title="$(var.ProductName)" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="Documentation" />
    </Feature>
  </Product>
</Wix>
