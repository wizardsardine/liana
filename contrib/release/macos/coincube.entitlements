<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Hardened-runtime entitlements for Coincube. Applied at codesign
        time via `rcodesign sign --entitlements-xml-path coincube.entitlements`
        (or equivalent). See contrib/release/macos/README.md for the full
        codesign + notarize workflow.

        Network entitlements are required for the local LAN signer
        (`phone_signer` module): we open a TCP listener during pairing,
        we dial the phone's TLS endpoint at steady state, and we
        multicast for the mDNS browse/advertise.
    -->

    <!-- Accept inbound TCP connections (pairing listener). -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Dial outbound TCP connections (PhoneSigner steady-state). -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
        Data-protection keychain access group for the device secret.

        The value is `<TeamID>.<bundleID>` and must stay in sync with
        CFBundleIdentifier in the Info.plist baked into `_coincube.zip`
        (io.coincube.tenshu). Team ID 8UVR249AD5 is written literally on
        purpose: `$(AppIdentifierPrefix)` and `$(TeamIdentifierPrefix)` are
        Xcode build-setting substitutions, and `rcodesign` signs this file
        verbatim without expanding anything — a signature carrying the raw
        variable string fails at runtime looking exactly like a keychain bug.

        The Rust side does not set kSecAttrAccessGroup, so items land in the
        first group listed here. An access group is part of a keychain item's
        identity: once a signed, entitled build has shipped, changing this
        value strands every device secret written under the old group.
    -->
    <key>keychain-access-groups</key>
    <array>
        <string>8UVR249AD5.io.coincube.tenshu</string>
    </array>
</dict>
</plist>
